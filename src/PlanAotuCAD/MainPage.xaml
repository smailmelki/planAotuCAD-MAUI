<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PlanAotuCAD.MainPage"
    BackgroundColor="#171B24">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0"
              BackgroundColor="#222936"
              Padding="10"
              RowDefinitions="Auto,Auto">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="PlanAotuCAD"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="CAD Workspace"
                       TextColor="#9BA8B8"
                       FontSize="12"
                       VerticalOptions="Center" />
            </Grid>

            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Margin="0,8,0,0">
                <HorizontalStackLayout Spacing="6">
                    <Button x:Name="SelectButton" Text="SELECT" Clicked="OnSelectToolClicked" />
                    <Button x:Name="LineButton" Text="LINE" Clicked="OnLineToolClicked" />
                    <Button x:Name="RectButton" Text="RECT" Clicked="OnRectToolClicked" />
                    <Button x:Name="CircleButton" Text="CIRCLE" Clicked="OnCircleToolClicked" />
                    <Button x:Name="EllipseButton" Text="ELLIPSE" Clicked="OnEllipseToolClicked" />
                    <Button x:Name="TriangleButton" Text="TRIANGLE" Clicked="OnTriangleToolClicked" />
                    <Button x:Name="ArcButton" Text="ARC" Clicked="OnArcToolClicked" />
                    <Button Text="UNDO" Clicked="OnUndoClicked" />
                    <Button Text="REDO" Clicked="OnRedoClicked" />
                    <Button Text="LAYERS" Clicked="OnLayersClicked" />
                    <Button Text="PROPERTIES" Clicked="OnPropertiesClicked" />
                    <Button Text="NUMERIC" Clicked="OnNumericInputClicked" />
                    <Button Text="DELETE" BackgroundColor="#B91C1C" Clicked="OnDeleteClicked" />
                    <Button Text="OPEN DRAWING" Clicked="OnOpenClicked" />
                    <Button Text="IMPORT DXF" Clicked="OnImportDxfClicked" />
                    <Button Text="SAVE DRAWING" BackgroundColor="#15803D" Clicked="OnSaveClicked" />
                    <Button Text="EXPORT DXF" BackgroundColor="#15803D" Clicked="OnExportDxfClicked" />
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <GraphicsView x:Name="CadView"
                      Grid.Row="1"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />

        <Grid Grid.Row="2"
              BackgroundColor="#222936"
              Padding="10"
              ColumnDefinitions="*,Auto">
            <Label x:Name="StatusLabel"
                   Text="Ready"
                   TextColor="#AAB6C5"
                   FontSize="12"
                   VerticalOptions="Center" />

            <Label x:Name="EntityCountLabel"
                   Grid.Column="1"
                   Text="0 entities"
                   TextColor="#AAB6C5"
                   FontSize="12"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
