<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PlanAotuCAD.MainPage"
    FlowDirection="LeftToRight"
    BackgroundColor="#EEF2F6">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#26364A" />
            <Setter Property="TextColor" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="38" />
            <Setter Property="MinimumWidthRequest" Value="68" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#F1F5F9" />
            <Setter Property="TextColor" Value="#334155" />
            <Setter Property="BorderColor" Value="#D7E0E9" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumWidthRequest" Value="72" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">

        <!-- شريط العنوان والأوامر -->
        <Grid Grid.Row="0"
              BackgroundColor="#142235"
              Padding="16,10"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="18">
            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                <Label Text="MelkiCAD"
                       TextColor="#FFFFFF"
                       FontSize="21"
                       FontAttributes="Bold" />
                <Label Text="محرر الرسم الهندسي"
                       TextColor="#A9BACD"
                       FontSize="11" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="7"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start">
                <Button Text="تراجع" Clicked="OnUndoClicked" />
                <Button Text="إعادة" Clicked="OnRedoClicked" />
                <Button Text="الطبقات" Clicked="OnLayersClicked" />
                <Button Text="خصائص العنصر" Clicked="OnPropertiesClicked" />
                <Button Text="إدخال رقمي" Clicked="OnNumericInputClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="7"
                                   VerticalOptions="Center">
                <Button Text="فتح" Clicked="OnOpenClicked" />
                <Button Text="استيراد DXF" Clicked="OnImportDxfClicked" />
                <Button Text="حفظ" BackgroundColor="#16845B" Clicked="OnSaveClicked" />
                <Button Text="تصدير DXF" BackgroundColor="#16845B" Clicked="OnExportDxfClicked" />
            </HorizontalStackLayout>
        </Grid>

        <!-- شريط أدوات الرسم -->
        <Grid Grid.Row="1"
              BackgroundColor="#FFFFFF"
              Padding="12,9"
              RowDefinitions="Auto,Auto">
            <Label Text="أدوات الرسم والتحديد"
                   TextColor="#64748B"
                   FontSize="11"
                   FontAttributes="Bold"
                   Margin="2,0,0,6" />
            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="7">
                    <Button x:Name="SelectButton" Text="تحديد" Style="{StaticResource ToolButton}" Clicked="OnSelectToolClicked" />
                    <Button x:Name="LineButton" Text="خط" Style="{StaticResource ToolButton}" Clicked="OnLineToolClicked" />
                    <Button x:Name="RectButton" Text="مستطيل" Style="{StaticResource ToolButton}" Clicked="OnRectToolClicked" />
                    <Button x:Name="CircleButton" Text="دائرة" Style="{StaticResource ToolButton}" Clicked="OnCircleToolClicked" />
                    <Button x:Name="EllipseButton" Text="بيضاوي" Style="{StaticResource ToolButton}" Clicked="OnEllipseToolClicked" />
                    <Button x:Name="TriangleButton" Text="مثلث" Style="{StaticResource ToolButton}" Clicked="OnTriangleToolClicked" />
                    <Button x:Name="ArcButton" Text="قوس" Style="{StaticResource ToolButton}" Clicked="OnArcToolClicked" />
                    <Button x:Name="PolylineButton" Text="متعدد الخطوط" Style="{StaticResource ToolButton}" Clicked="OnPolylineToolClicked" />
                    <Button x:Name="PolygonButton" Text="مضلع" Style="{StaticResource ToolButton}" Clicked="OnPolygonToolClicked" />
                    <Button Text="حذف المحدد" BackgroundColor="#FCE8E8" TextColor="#B42318" BorderColor="#F3C6C3" BorderWidth="1" Clicked="OnDeleteClicked" />
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <!-- مساحة العمل -->
        <Grid Grid.Row="2" Padding="10" BackgroundColor="#E8EDF3">
            <Border Stroke="#D4DDE7"
                    StrokeThickness="1"
                    BackgroundColor="#F8FAFC"
                    StrokeShape="RoundRectangle 10"
                    Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid BackgroundColor="#F1F5F9"
                          Padding="12,7"
                          ColumnDefinitions="*,Auto">
                        <Label Text="مساحة الرسم"
                               TextColor="#334155"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="اسحب للرسم • استخدم عجلة الفأرة للتكبير"
                               TextColor="#8291A3"
                               FontSize="10"
                               VerticalOptions="Center" />
                    </Grid>
                    <GraphicsView x:Name="CadView"
                                  Grid.Row="1"
                                  BackgroundColor="#FBFCFE"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />
                </Grid>
            </Border>
        </Grid>

        <!-- خصائص العنصر: تبقى مدمجة في مساحة العمل -->
        <Border x:Name="PropertiesPanel"
                Grid.Row="3"
                IsVisible="False"
                BackgroundColor="#FFFFFF"
                Stroke="#D7E0E9"
                StrokeThickness="1"
                Padding="12,9"
                Margin="10,0,10,8"
                StrokeShape="RoundRectangle 10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Label Text="خصائص العنصر المحدد"
                       TextColor="#24364B"
                       FontAttributes="Bold"
                       FontSize="12" />
                <ScrollView Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                        <Entry x:Name="PropertyNameEntry" Placeholder="اسم العنصر" WidthRequest="150" />
                        <Entry x:Name="PropertyColorEntry" Placeholder="اللون #RRGGBB" WidthRequest="125" />
                        <Entry x:Name="PropertyWidthEntry" Placeholder="سمك الخط" WidthRequest="95" Keyboard="Numeric" />
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="تعبئة" TextColor="#475569" VerticalOptions="Center" FontSize="12" />
                            <Switch x:Name="PropertyFillSwitch" />
                        </HorizontalStackLayout>
                        <Picker x:Name="PropertyLayerPicker" Title="الطبقة" WidthRequest="150" />
                        <Button Text="تطبيق" BackgroundColor="#16845B" Clicked="OnApplyPropertiesClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- شريط الحالة -->
        <Grid Grid.Row="4"
              BackgroundColor="#142235"
              Padding="14,8"
              ColumnDefinitions="*,Auto">
            <Label x:Name="StatusLabel"
                   Text="جاهز للرسم"
                   TextColor="#D8E2ED"
                   FontSize="11"
                   VerticalOptions="Center" />
            <Label x:Name="EntityCountLabel"
                   Grid.Column="1"
                   Text="0 عنصر"
                   TextColor="#A9BACD"
                   FontSize="11"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
