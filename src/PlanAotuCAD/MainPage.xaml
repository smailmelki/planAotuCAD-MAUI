<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PlanAotuCAD.MainPage"
    FlowDirection="LeftToRight"
    BackgroundColor="#E9EEF4">

    <ContentPage.Resources>
        <Color x:Key="Ink">#172638</Color>
        <Color x:Key="Muted">#8291A3</Color>
        <Color x:Key="Line">#DCE3EB</Color>
        <Style x:Key="DockButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#24364B"/>
            <Setter Property="TextColor" Value="#F4F7FB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="HeightRequest" Value="66"/>
            <Setter Property="WidthRequest" Value="88"/>
            <Setter Property="ContentLayout" Value="Top,4"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="BorderColor" Value="#3C5068"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#26394F"/>
            <Setter Property="TextColor" Value="#EAF0F7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HeightRequest" Value="38"/>
            <Setter Property="ContentLayout" Value="Left,6"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="0">
        <!-- رأس التطبيق: هوية المشروع وأوامر الملف -->
        <Grid Grid.Row="0" BackgroundColor="#142235" Padding="16,9"
              ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                <Label Text="MelkiCAD" TextColor="White" FontSize="20" FontAttributes="Bold"/>
                <Label Text="محرر المخططات الهندسية" TextColor="#AAB9CA" FontSize="10"/>
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                <Button Text="تراجع" ImageSource="cad-undo.svg" Style="{StaticResource HeaderButton}" Clicked="OnUndoClicked"/>
                <Button Text="إعادة" ImageSource="cad-redo.svg" Style="{StaticResource HeaderButton}" Clicked="OnRedoClicked"/>
                <Button Text="فتح" Style="{StaticResource HeaderButton}" Clicked="OnOpenClicked"/>
                <Button Text="حفظ" ImageSource="cad-save.svg" BackgroundColor="#147D60" TextColor="White"
                        Style="{StaticResource HeaderButton}" Clicked="OnSaveClicked"/>
            </HorizontalStackLayout>
            <Label Grid.Column="2" Text="CAD  •  NATIVE" TextColor="#8297AD" FontSize="10"
                   VerticalOptions="Center" CharacterSpacing="1"/>
        </Grid>

        <!-- شريط الاختصاصات: قوائم مصنفة بدلاً من ازدحام الأدوات -->
        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="#1B2B3E" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="12,9" Spacing="8">
                <Button Text="الرسم" ImageSource="cad-draw.svg"
                        Style="{StaticResource DockButton}" Clicked="OnDrawGroupClicked"/>
                <Button Text="التعديل والتحديد" ImageSource="cad-edit.svg"
                        Style="{StaticResource DockButton}" Clicked="OnEditGroupClicked"/>
                <Button Text="الطبقات والخصائص" ImageSource="cad-layers.svg"
                        Style="{StaticResource DockButton}" Clicked="OnLayersGroupClicked"/>
                <Button Text="الملفات و DXF" ImageSource="cad-file.svg"
                        Style="{StaticResource DockButton}" Clicked="OnFilesGroupClicked"/>
                <Button Text="الدقة والإدخال" ImageSource="cad-view.svg"
                        Style="{StaticResource DockButton}" Clicked="OnViewGroupClicked"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- مساحة الرسم هي مركز الواجهة -->
        <Grid Grid.Row="2" Padding="10" BackgroundColor="#E9EEF4">
            <Border Stroke="#D5DEE8" StrokeThickness="1" BackgroundColor="#FFFFFF"
                    StrokeShape="RoundRectangle 10" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid BackgroundColor="#F5F7FA" Padding="13,7" ColumnDefinitions="*,Auto">
                        <Label Text="مساحة العمل" TextColor="#26394F" FontSize="12"
                               FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="زر الفأرة الأوسط للتحريك  •  عجلة الفأرة للتكبير"
                               TextColor="#8291A3" FontSize="10" VerticalOptions="Center"/>
                    </Grid>
                    <GraphicsView x:Name="CadView" Grid.Row="1" BackgroundColor="#FCFDFE"
                                  HorizontalOptions="Fill" VerticalOptions="Fill"/>
                </Grid>
            </Border>
        </Grid>

        <!-- خصائص العنصر تظهر عند التحديد وتبقى مدمجة -->
        <Border x:Name="PropertiesPanel" Grid.Row="3" IsVisible="False"
                BackgroundColor="White" Stroke="#DCE3EB" StrokeThickness="1"
                Padding="12,8" Margin="10,0,10,8" StrokeShape="RoundRectangle 9">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                <Label Text="خصائص العنصر المحدد" TextColor="#26394F"
                       FontAttributes="Bold" FontSize="12"/>
                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Entry x:Name="PropertyNameEntry" Placeholder="اسم العنصر" WidthRequest="145"/>
                        <Entry x:Name="PropertyColorEntry" Placeholder="اللون #RRGGBB" WidthRequest="125"/>
                        <Entry x:Name="PropertyWidthEntry" Placeholder="سمك الخط" WidthRequest="95" Keyboard="Numeric"/>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="تعبئة" TextColor="#526174" FontSize="12" VerticalOptions="Center"/>
                            <Switch x:Name="PropertyFillSwitch"/>
                        </HorizontalStackLayout>
                        <Picker x:Name="PropertyLayerPicker" Title="الطبقة" WidthRequest="145"/>
                        <Button Text="تطبيق" BackgroundColor="#147D60" TextColor="White"
                                CornerRadius="8" Clicked="OnApplyPropertiesClicked"/>
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- شريط الحالة -->
        <Grid Grid.Row="4" BackgroundColor="#142235" Padding="13,7"
              ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
            <Label x:Name="StatusLabel" Text="جاهز — اختر اختصاصاً من شريط الأدوات"
                   TextColor="#DCE5EF" FontSize="11" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="MODEL SPACE" TextColor="#8297AD"
                   FontSize="9" VerticalOptions="Center"/>
            <Label x:Name="EntityCountLabel" Grid.Column="2" Text="0 عنصر"
                   TextColor="#B9C8D8" FontSize="11" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>